# Server
PORT=8787
# Comma-separated list of API keys the iOS app must send as `x-jarvis-key` to call this server.
JARVIS_API_KEYS=changeme-generate-a-long-random-string

# Google OAuth (Gmail). Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API for the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=jarvis://oauth/gmail/callback

# Market data: Alpha Vantage free tier - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Comma-separated tickers to track by default, e.g. AAPL,MSFT,SPY
DEFAULT_WATCHLIST=AAPL,MSFT,SPY,QQQ

# News: NewsAPI.org free tier - https://newsapi.org/register
NEWS_API_KEY=

# Anthropic API key, used to draft emails/texts for the "Ask Jarvis" voice
# flow - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Push notifications (APNs) for delivering the daily brief to the iOS app
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.yourname.jarvis
APNS_PRIVATE_KEY_PATH=./secrets/AuthKey.p8

# What time (24h, server-local) the daily brief should be generated and pushed
DAILY_BRIEF_CRON=0 7 * * *

# Twilio — places a real phone call reading an alert aloud. Paid service:
# a phone number (~$1/mo) plus ~$0.013/min per call. Get an account and
# number at https://www.twilio.com/console. Leave these blank to keep
# call-alerts off (the app's toggle stays disabled until all four are set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The phone Jarvis calls — almost always your own number.
CALL_TO_NUMBER=

# How often to check for call-worthy conditions, and what counts as one.
ALERT_CHECK_CRON=*/30 * * * *
CALL_MARKET_MOVE_THRESHOLD_PERCENT=3
CALL_ON_URGENT_EMAIL=true
CALL_COOLDOWN_MINUTES=120

# Optional: lets the unattended alert-check cron read Gmail without the
# app being open. Set GMAIL_LOG_REFRESH_TOKEN=true temporarily, connect
# Gmail once in the app, copy the refresh token the server logs, paste it
# here, then unset GMAIL_LOG_REFRESH_TOKEN. Without this, market-move
# call-alerts still work; the urgent-email check is skipped.
GMAIL_LOG_REFRESH_TOKEN=false
GMAIL_SERVER_REFRESH_TOKEN=
